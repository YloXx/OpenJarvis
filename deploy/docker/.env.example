# OpenJarvis Docker settings. `./install.sh` copies this to `.env` (in this
# directory) and fills in OPENJARVIS_API_KEY for you. To do it by hand:
#
#   cp .env.example .env
#   sed -i "s/^OPENJARVIS_API_KEY=.*/OPENJARVIS_API_KEY=$(openssl rand -hex 32)/" .env
#   docker compose up -d --build
#
# Everything in this file is also passed to the OpenJarvis container, so any
# extra variable OpenJarvis understands (tool or channel tokens, ...) can be
# added here too. Never commit the filled-in .env.

# --- Required --------------------------------------------------------------

# API key for the OpenJarvis server. The container binds 0.0.0.0, so the server
# refuses to start without one. Clients send `Authorization: Bearer <key>`;
# in the web UI paste it under Settings -> API key.
OPENJARVIS_API_KEY=

# --- Model -----------------------------------------------------------------

# Default model served by OpenJarvis. Pulled into Ollama automatically on the
# first start. Larger local options: qwen3.5:4b, qwen3.5:9b, qwen3.5:27b.
OPENJARVIS_MODEL=qwen3.5:2b

# Ollama models to make sure are present before the server starts
# (space-separated). Defaults to OPENJARVIS_MODEL when unset; set it to an
# empty value to skip pulling entirely (e.g. cloud-only with a cloud model).
#OLLAMA_PULL=qwen3.5:2b qwen3.5:9b

# --- Network ---------------------------------------------------------------

# Host interface and port for the OpenJarvis web UI + API. The loopback default
# keeps it on this machine; use 0.0.0.0 to reach it from your network.
OPENJARVIS_BIND=127.0.0.1
OPENJARVIS_PORT=8000

# Ollama is always published on 127.0.0.1 only (it has no authentication).
#OLLAMA_PORT=11434

# --- Optional cloud providers ----------------------------------------------

# Set any of these to make cloud models available next to the local ones.
#OPENAI_API_KEY=
#ANTHROPIC_API_KEY=
#GEMINI_API_KEY=
#OPENROUTER_API_KEY=

# --- Image -----------------------------------------------------------------

# Optional-dependency groups baked into the image at build time
# (space-separated, must include `server`). Rebuild after changing it:
# `docker compose up -d --build`.
#OPENJARVIS_EXTRAS=server inference-cloud inference-google

# Use a prebuilt image instead of the local build tag (openjarvis:local).
#OPENJARVIS_IMAGE=
